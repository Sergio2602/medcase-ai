ANTHROPIC_API_KEY=your_api_key_here
# Optional — defaults to claude-sonnet-4-6
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Pipeline v2 (scripts/generate-case-v2.ts) — jeweils optional, fallen sonst auf
# ANTHROPIC_MODEL (s.o.) zurueck. Nur setzen, wenn eine Stufe explizit ein anderes
# Modell nutzen soll.
# ANTHROPIC_MODEL_FACTSHEET=claude-sonnet-4-6
# ANTHROPIC_MODEL_CONSTRUCT=claude-sonnet-4-6
# ANTHROPIC_MODEL_VERIFY=claude-sonnet-4-6
# ANTHROPIC_MODEL_DETECT=claude-sonnet-4-6

# Serper.dev API-Key fuer Stufe 4 (Plagiats-/Anti-Copy-Check via Websuche).
# Ohne diesen Key faellt Stufe 4 auf den Anthropic-eigenen web_search-Fallback
# zurueck (schwaecher, siehe Audit vom 2026-09-15 / BLOCKING 7) — dringend empfohlen.
# SERPER_API_KEY=your_serper_key_here

# PostHog Analytics (EU-Cloud, cookieless) — ohne Key: Analytics ist no-op
NEXT_PUBLIC_POSTHOG_KEY=phc_your_key_here
# Optional — Default ist https://eu.i.posthog.com
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Zugangs-Key für den Reviewer-Pfad /review?key=... (nur Reviewer erhalten ihn)
REVIEW_ACCESS_KEY=ein-langer-zufaelliger-string
